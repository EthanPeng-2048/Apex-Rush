{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "release",
      "displayName": "Clang Release (O3 + ThinLTO)",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "APEX_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "release-avx2",
      "displayName": "Clang Release, x86-64-v3 baseline (AVX2+FMA)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-avx2",
      "cacheVariables": { "APEX_NATIVE_ARCH": "ON" }
    },
    {
      "name": "release-static",
      "displayName": "Clang Release + Static CRT (no VC++ redist on target)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build-static",
      "cacheVariables": { "APEX_STATIC_RUNTIME": "ON" }
    },
    {
      "name": "debug",
      "displayName": "Clang Debug",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "APEX_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "debug-tools",
      "displayName": "Clang Debug + Tools (game + mapconv)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build-tools",
      "cacheVariables": { "APEX_BUILD_TOOLS": "ON" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "displayName": "Linux (compiler from CC/CXX, defaults to the system cc/c++)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "release-linux",
      "displayName": "Linux Release (portable x86-64 baseline)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "APEX_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "release-linux-avx2",
      "displayName": "Linux Release, x86-64-v3 baseline (AVX2+FMA)",
      "inherits": "release-linux",
      "binaryDir": "${sourceDir}/build-linux-avx2",
      "cacheVariables": { "APEX_NATIVE_ARCH": "ON" }
    },
    {
      "name": "web",
      "displayName": "Emscripten WASM (run emsdk_env first)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-web",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "APEX_BUILD_TOOLS": "OFF",
        "PLATFORM": "Web"
      }
    },
    {
      "name": "web-single",
      "displayName": "Emscripten single-file HTML (offline dist/)",
      "inherits": "web",
      "binaryDir": "${sourceDir}/build-web-single",
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-sSINGLE_FILE=1",
        "APEX_PACK_SINGLE_HTML": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "jobs": 32 },
    { "name": "release-avx2", "configurePreset": "release-avx2", "jobs": 32 },
    { "name": "release-static", "configurePreset": "release-static", "jobs": 32 },
    { "name": "debug", "configurePreset": "debug", "jobs": 32 },
    { "name": "debug-tools", "configurePreset": "debug-tools", "jobs": 32 },
    { "name": "release-linux", "configurePreset": "release-linux", "jobs": 32 },
    { "name": "release-linux-avx2", "configurePreset": "release-linux-avx2", "jobs": 32 },
    { "name": "web", "configurePreset": "web", "jobs": 32 },
    { "name": "web-single", "configurePreset": "web-single", "jobs": 32 }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux",
      "output": { "outputOnFailure": true }
    }
  ]
}
